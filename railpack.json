{
  "$schema": "https://schema.railpack.com",
  "packages": {},
  "steps": {
    "setup-tools": {
      "commands": [
        "curl -fsSL https://deb.nodesource.com/setup_20.x | bash -",
        "apt-get install -y nodejs",
        "mkdir -p /app/.bin",
        "curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- -d /app/.bin",
        "ln -sf /app/.bin/agy /usr/local/bin/agy"
      ]
    }
  },
  "deploy": {
    "startCommand": "bash ./entrypoint.sh daemon",
    "variables": {
      "CLONE_REPOSITORIES": "usuario/mi-repo, https://github.com/otro/repo.git",
      "TARGET_BRANCH": "antigravity",
      "DB_DATABASE": "laravel",
      "DB_USERNAME": "laravel_user",
      "DB_PASSWORD": "secret"
    },
    "aptPackages": [
      "curl",
      "git",
      "gh",
      "unzip",
      "zip",
      "nano",
      "tmux",
      "sqlite3",
      "mariadb-server"
    ]
  }
}
