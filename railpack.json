{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "...",
        "curl -L https://raw.githubusercontent.com/tj/n/master/bin/n -o /usr/local/bin/n && chmod +x /usr/local/bin/n",
        "n 24",
        "mkdir -p /app/.bin",
        "curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- -d /app/.bin",
        "ln -sf /app/.bin/agy /usr/local/bin/agy"
      ]
    }
  },
  "deploy": {
    "startCommand": "bash ./entrypoint.sh daemon",
    "variables": {
      "TARGET_BRANCH": "antigravity",
      "DB_DATABASE": "laravel",
      "DB_USERNAME": "laravel_user",
      "DB_PASSWORD": "secret"
    },
    "aptPackages": [
      "curl",
      "git",
      "gh",
      "unzip",
      "zip",
      "nano",
      "tmux",
      "sqlite3",
      "mariadb-server"
    ]
  }
}