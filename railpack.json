{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "php": "8.4",
    "node": "20"
  },
  "steps": {
    "setup-tools": {
      "commands": [
        "mkdir -p /app/.bin",
        "curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- -d /app/.bin",
        "curl -sSL https://github.com/cli/cli/releases/download/v2.57.0/gh_2.57.0_linux_amd64.tar.gz | tar xz -C /app/.bin --strip-components=2 gh_2.57.0_linux_amd64/bin/gh",
        "chmod +x /app/.bin/agy /app/.bin/gh"
      ]
    }
  },
  "deploy": {
    "startCommand": "bash ./entrypoint.sh daemon",
    "aptPackages": [
      "curl",
      "git",
      "unzip",
      "zip",
      "nano",
      "tmux",
      "sqlite3"
    ]
  }
}
