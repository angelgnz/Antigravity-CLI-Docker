{
    "name": "antigravity/coolify-daemon",
    "description": "Antigravity CLI Daemon for Coolify",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "ext-redis": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-exif": "*"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
