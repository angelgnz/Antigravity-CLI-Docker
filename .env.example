# ==============================================================================
# Antigravity Remote Control Daemon Configuration
# ==============================================================================

# Nombre de la máquina/instancia que aparecerá en Remote Control (https://antigravity.google)
INSTANCE_NAME=vps-antigravity-server

# Puerto del hub local interno de agy (por defecto 4400)
HUB_PORT=4400

# Puerto público para previsualizar proyectos Laravel (php artisan serve)
APP_PORT=8000

# Zona horaria del contenedor
TZ=UTC

# ==============================================================================
# Permisos y Políticas de Antigravity (Opcional)
# Si no se definen, se conserva el comportamiento por defecto de Antigravity.
# ==============================================================================

# Master switch para auto-aprobar todo (herramientas + artefactos/código)
# AUTO_APPROVE=true

# Política para ejecución de herramientas y comandos de terminal:
# Opciones: "always-proceed" (o true), "request-review" (o false, default), "proceed-in-sandbox", "strict"
# TOOL_PERMISSION=always-proceed

# Política para revisión y aplicación de cambios de código / artefactos:
# Opciones: "always-proceed" (o true), "asks-for-review" (o false, default), "agent-decides"
# ARTIFACT_REVIEW_POLICY=always-proceed

# ==============================================================================
# GitHub CLI Configuration (Opcional)
# ==============================================================================
# Si defines este token (Personal Access Token con permisos repo/read/write),
# gh CLI estará autenticado automáticamente sin necesidad de gh auth login interactivo.
GH_TOKEN=
GITHUB_TOKEN=

# ==============================================================================
# Auto-Clone Repositories
# ==============================================================================
# Lista de repositorios separados por comas (ej. usuario/repo, https://github.com/...)
CLONE_REPOSITORIES=
# Rama objetivo a usar o crear (por defecto: antigravity)
TARGET_BRANCH=antigravity

# ==============================================================================
# Database Configuration (Laravel)
# ==============================================================================
# Conexión por defecto para proyectos Laravel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_secret_pass_change_me

# Contraseña de root si utilizas el servicio de base de datos incluido (--profile with-db)
DB_ROOT_PASSWORD=root_super_secret_change_me
