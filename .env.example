# ==============================================================================
# Antigravity Remote Control Daemon Configuration
# ==============================================================================

# Nombre de la máquina/instancia que aparecerá en Remote Control (https://antigravity.google)
INSTANCE_NAME=vps-antigravity-server

# Puerto del hub local interno de agy (por defecto 4400)
HUB_PORT=4400

# Puerto público para previsualizar proyectos Laravel (php artisan serve)
APP_PORT=8000

# Zona horaria del contenedor
TZ=UTC

# ==============================================================================
# GitHub CLI Configuration (Opcional)
# ==============================================================================
# Si defines este token (Personal Access Token con permisos repo/read/write),
# gh CLI estará autenticado automáticamente sin necesidad de gh auth login interactivo.
GH_TOKEN=
GITHUB_TOKEN=

# ==============================================================================
# Database Configuration (Laravel)
# ==============================================================================
# Conexión por defecto para proyectos Laravel
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_secret_pass_change_me

# Contraseña de root si utilizas el servicio de base de datos incluido (--profile with-db)
DB_ROOT_PASSWORD=root_super_secret_change_me
